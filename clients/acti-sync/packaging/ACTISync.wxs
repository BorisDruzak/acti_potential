<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <!-- Preserve the released ProductLanguage for major-upgrade detection; the wizard uses Russian text. -->
  <Package Name="ACTI Sync" Manufacturer="ACTI" Version="$(var.Version)"
           UpgradeCode="46C46CCD-DB5A-4A73-942C-4B3E8FDF8B0D" Scope="perMachine" InstallerVersion="500"
           Language="1033" Codepage="1251">
    <MajorUpgrade DowngradeErrorMessage="A newer ACTI Sync is already installed." Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" MaximumUncompressedMediaSize="600" />
    <Property Id="ACTISOURCESHA" Value="$(var.SourceSha)" />
    <!-- Word owns the user's document session; installation must never close it or reboot. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <Property Id="REBOOT" Value="ReallySuppress" />
    <Property Id="SERVERORIGIN" Secure="yes" Hidden="yes" />
    <Property Id="EXISTINGSERVERORIGIN" Secure="yes" Hidden="yes">
      <RegistrySearch Id="ExistingOrigin" Root="HKLM" Key="SOFTWARE\ACTI\Sync" Name="ServerOrigin" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="SERVERORIGIN" Value="[EXISTINGSERVERORIGIN]" Before="LaunchConditions"
                 Sequence="both" Condition="NOT SERVERORIGIN AND EXISTINGSERVERORIGIN" />
    <Launch Condition="Installed OR UILevel &gt;= 5 OR SERVERORIGIN"
            Message="Укажите SERVERORIGIN=https://имя-сервера для установки ACTI Sync." />
    <Binary Id="InstallerActions" SourceFile="$(var.InstallerActionsDir)\ACTISync.InstallerActions.CA.dll" />
    <CustomAction Id="CheckServer" BinaryRef="InstallerActions" DllEntry="CheckServer"
                  Execute="immediate" Return="check" />
    <CustomAction Id="ValidateServerOrigin" BinaryRef="InstallerActions" DllEntry="ValidateServerOrigin"
                  Execute="immediate" Return="check" />
    <UIRef Id="ACTIServerUI" />
    <CustomAction Id="CleanupUpdaterPolicy" FileRef="UpdaterExe" ExeCommand="--uninstall-cleanup"
                  Execute="deferred" Impersonate="no" Return="check" />
    <InstallExecuteSequence>
      <!-- Always enforce syntax before writes, including /qn and /qb. No network in the execute sequence. -->
      <Custom Action="ValidateServerOrigin" Before="InstallInitialize" Condition="NOT Installed AND NOT (REMOVE ~= &quot;ALL&quot;)" />
      <Custom Action="CleanupUpdaterPolicy" After="StopServices" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="ACTIDIR" Name="ACTI">
        <Directory Id="INSTALLFOLDER" Name="Sync">
          <Component Id="Service" Guid="22918F35-CBB9-4AE8-B845-F10328826CE1" Bitness="always64">
            <File Id="ServiceExe" Source="$(var.ServiceDir)\ACTISync.Service.exe" KeyPath="yes" />
            <ServiceInstall Id="InstallService" Name="ACTISync" DisplayName="ACTI Sync"
                Description="Durable background synchronization of ACTI Word working originals."
                Type="ownProcess" Start="auto" ErrorControl="normal" Account="NT AUTHORITY\LocalService">
              <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart"
                  ThirdFailureActionType="restart" RestartServiceDelayInSeconds="15" ResetPeriodInDays="1" />
            </ServiceInstall>
            <ServiceControl Id="ControlService" Name="ACTISync" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
          </Component>
          <Component Id="Updater" Guid="676216F2-49E7-4351-8FF7-E306C393D3ED" Bitness="always64">
            <File Id="UpdaterExe" Source="$(var.UpdaterDir)\ACTISync.Updater.exe" KeyPath="yes" />
            <ServiceInstall Id="InstallUpdater" Name="ACTISyncUpdater" DisplayName="ACTI Sync Automatic Updates"
                Description="Installs only verified ACTI Sync releases and resumes existing interactive sessions."
                Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem">
              <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart"
                  ThirdFailureActionType="restart" RestartServiceDelayInSeconds="30" ResetPeriodInDays="1" />
            </ServiceInstall>
            <ServiceControl Id="ControlUpdater" Name="ACTISyncUpdater" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
          </Component>
          <Component Id="User" Guid="5E755634-82E1-4597-BFDE-3B4FBF68A5A4" Bitness="always64">
            <File Id="UserExe" Source="$(var.UserDir)\ACTISync.User.exe" KeyPath="yes" />
            <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run" Name="ACTISync" Value="&quot;[#UserExe]&quot;" Type="string" />
            <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\acti-sync" Value="URL:ACTI Sync" Type="string" />
            <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\acti-sync" Name="URL Protocol" Value="" Type="string" />
            <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\acti-sync\shell\open\command" Value="&quot;[#UserExe]&quot; &quot;%1&quot;" Type="string" />
          </Component>
          <Component Id="Tray" Guid="248F6A3C-AF4C-40BB-83BE-C7DAF2926673" Bitness="always64">
            <File Id="TrayExe" Source="$(var.TrayDir)\ACTISync.Tray.exe" KeyPath="yes" />
            <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run" Name="ACTISyncTray" Value="&quot;[#TrayExe]&quot;" Type="string" />
          </Component>
          <Component Id="Configuration" Guid="F8996799-7DFC-47E3-AAC5-7F957C771B81" Bitness="always64">
            <RegistryValue Root="HKLM" Key="SOFTWARE\ACTI\Sync" Name="ServerOrigin" Value="[SERVERORIGIN]" Type="string" KeyPath="yes" />
            <RegistryValue Root="HKLM" Key="SOFTWARE\ACTI\Sync" Name="InstalledVersion" Value="$(var.Version)" Type="string" />
            <RegistryValue Root="HKLM" Key="SOFTWARE\ACTI\Sync" Name="InstalledSourceSha" Value="$(var.SourceSha)" Type="string" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="ACTIDATA" Name="ACTI">
        <Directory Id="SYNCDATA" Name="Sync">
          <!-- Queue/workspaces are runtime data, deliberately absent from RemoveFile/RemoveFolder. -->
          <Component Id="DataDirectory" Guid="A5E71B99-B1D8-4E2D-96CE-05DA03F0D483" Permanent="yes" Bitness="always64">
            <CreateFolder>
              <PermissionEx Sddl="D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;FA;;;LS)" />
            </CreateFolder>
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    <Feature Id="Product" Title="ACTI Sync" Level="1">
      <ComponentRef Id="Service" /><ComponentRef Id="User" /><ComponentRef Id="Updater" /><ComponentRef Id="Tray" />
      <ComponentRef Id="Configuration" /><ComponentRef Id="DataDirectory" />
    </Feature>
  </Package>
</Wix>
