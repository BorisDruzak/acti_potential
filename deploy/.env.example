# Store populated configuration outside the checkout, mode 0600.
ACTI_DATABASE_URL=
ACTI_REDIS_URL=redis://redis:6379/0
ACTI_ORIGIN=https://acti.example.invalid
# Optional canonical DNS name, internal Docker alias and public issuing CA.
# ACTI_PUBLIC_HOST=acti.example.invalid
# ACTI_HTTPS_CA_FILE=/etc/acti-v3/tls/domain-ca.crt
# Keep local management-leaf renewal independent of the domain certificate.
# ACTI_TLS_RENEWAL_ORIGIN=https://localhost
ACTI_SESSION_SECRET=
ACTI_STORAGE_ROOT=/documents
ACTI_POSTGRES_UUID=
ACTI_DOCUMENTS_UUID=
POSTGRES_PASSWORD=
POSTGRES_IMAGE=
REDIS_IMAGE=
ACTI_SOURCE_SHA=
ACTI_RELEASE_DIR=
ACTI_MIGRATION_DATABASE_URL=
ACTI_APP_PASSWORD=
ACTI_OWNER_PASSWORD=
ACTI_TRUSTED_PROXY_CIDRS=
# Optional search tuning (JSON); null/omission retains built-in defaults.
# ACTI_SEARCH_WEIGHTS={"number":1,"title_exact":0.95,"title_partial":0.8,"metadata":0.6,"content":0.4,"fuzzy":0.15}
# ACTI_SEARCH_SYNONYMS=[["ЖКХ","жилищно-коммунальное хозяйство"],["НПА","нормативный правовой акт"]]
# ACTI_SEARCH_ALGORITHM_VERSION=lexical-2
